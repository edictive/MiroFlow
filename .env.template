# Must have for minimal agent get started
OPENROUTER_API_KEY="sk-or-v1-xxx"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Direct OpenAI access for Whisper transcription
OPENAI_WHISPER_API_KEY="sk-xxx"
OPENAI_WHISPER_BASE_URL="https://api.openai.com/v1"
OPENAI_WHISPER_MODEL="whisper-1"

# Logging configuration
# Override the log directory or explicit log file as needed
LOGGER_DIR="logs"
# LOGGER_FILE="logs/miroflow-debug.log"

# Model routing defaults
OPENAI_MODEL_NAME="qwen/qwen3-next-80b-a3b-thinking"
# OPENAI_PROVIDER=""
# Optional: override worker model separately
# WORKER_MODEL_NAME="qwen/qwen3-next-80b-a3b-thinking"
# WORKER_PROVIDER=""
# Force Gemini vision stack to prefer OpenRouter
VISION_PREFERRED_PROVIDER="gemini"
OPENROUTER_EVAL_MODEL="anthropic/claude-3.7-sonnet"
